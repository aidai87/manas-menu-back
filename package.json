{
  "name": "back-manas",
  "version": "1.0.0",
  "description": "Backend for Manas University cafeteria menu",
  "main": "public/index.js",
  "type": "module",
  "scripts": {
    "scrape": "node public/index.js",
    "start": "node public/server.js",
    "dev": "node --watch public/server.js",
    "test": "vitest run",

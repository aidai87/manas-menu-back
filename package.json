  },
  "dependencies": {
    "axios": "^1.6.7",
    "cheerio": "^1.0.0-rc.12",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "nock": "^13.5.6",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
